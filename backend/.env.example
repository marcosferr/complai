# Local development env example
DEBUG=True
SECRET_KEY=change-me-for-local
DJANGO_SETTINGS_MODULE=config.settings.development
DB_NAME=compliance_tracker
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# AI Processing
ENABLE_AI_PROCESSING=false
OPENAI_API_KEY=

# --- Endurecimiento ISO 27001 (oleadas T-4 / T-5 / T-6) ----------------------
# Obligatorias cuando DEBUG=False: sin ellas la aplicación NO arranca (A.8.9).
# SECRET_KEY=
# ALLOWED_HOSTS=

# Cuántos proxies de confianza hay delante de Django. Cada uno agrega UNA entrada
# a X-Forwarded-For; el límite por IP cuenta desde la derecha con este número.
# En el servidor son dos (Apache :80 + nginx del compose). Si se saca uno, bajarlo
# — de lo contrario los límites por IP se vuelven esquivables (A.8.5).
TRUSTED_PROXY_HOPS=2

